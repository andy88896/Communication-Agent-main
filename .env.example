# Gmail account email addresses
GMAIL_EMAIL_PRIMARY=your_primary_email@gmail.com
GMAIL_EMAIL_SECONDARY=your_secondary_email@gmail.com

# OAuth credentials JSON (contents of the downloaded credentials file, as a single-line JSON string)
GMAIL_CREDENTIALS_PRIMARY=
GMAIL_CREDENTIALS_SECONDARY=

# OAuth tokens (auto-populated by setup_oauth.py — do not edit manually)
GMAIL_TOKEN_PRIMARY=
GMAIL_TOKEN_SECONDARY=

# Notion integration secret (from notion.so/my-integrations)
NOTION_API_KEY=

# ID of the Notion page where action items are appended
# Extract from the page URL: notion.so/Page-Title-<PAGE_ID>
NOTION_PAGE_ID=

# Anthropic API key
ANTHROPIC_API_KEY=
